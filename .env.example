# Kosongkan DATABASE_URL untuk memakai SQLite lokal (otomatis, tanpa setup apa pun).
DATABASE_URL=

# Contoh Neon (salin "Pooled connection" dari dashboard Neon):
# DATABASE_URL=postgresql://user:password@ep-nama-1234-pooler.ap-southeast-1.aws.neon.tech/livepoll?sslmode=require&channel_binding=require

# Contoh Postgres biasa:
# DATABASE_URL=postgresql://user:password@host:5432/livepoll
